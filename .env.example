PUBLIC_BEEHIIV_PUBLICATION_ID=your_publication_id_here
# BEEHIIV_API_KEY=your_beehiiv_api_key_here

# Payments: leave unset in production until Paddle is connected (checkout shows as a preview and
# nothing can be charged or published). "test" lets you post and hype without a charge, for local
# dev and staging only. "paddle" turns on the Paddle webhook below.
# PAYMENTS_MODE=test
# PADDLE_WEBHOOK_SECRET=pdl_ntfset_...

# Admin moderation: POST /api/spot/admin/opinions/<id>/hide with "Authorization: Bearer <token>".
# Use a long random value (at least 24 characters), stored as a secret.
# ADMIN_TOKEN=
